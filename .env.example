# Copy to .env and fill in. Never commit .env.
# Empty values mean "use the local fallback" (SQLite, on-disk Qdrant, local files, mock VLM).

# --- API ---
DATABASE_URL=sqlite:///./data/videomind.db
PUBLIC_BASE_URL=http://127.0.0.1:43124
API_KEY=
SIGNING_SECRET=dev-only-change-me
PRESIGN_TTL_S=3600
RATE_LIMIT_PER_MINUTE=120

# --- Qdrant ---
# Leave QDRANT_URL empty to use the embedded local store at QDRANT_PATH.
# Use :memory: only for tests. For docker compose set QDRANT_URL=http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=segments

# --- Object storage ---
# Leave S3_ENDPOINT empty to store objects on the local disk under DATA_DIR.
# MinIO (compose): S3_ENDPOINT=http://minio:9000  S3_ACCESS_KEY=minio  S3_SECRET_KEY=minio-secret
# Cloudflare R2: S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=videomind
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_USE_SSL=false
DATA_DIR=./data

# --- ASR ---
# CPU dev: tiny or small. GPU: large-v3 with WHISPER_DEVICE=cuda and WHISPER_COMPUTE_TYPE=float16
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Captions ---
# mock | tesseract | openrouter | vllm
CAPTION_BACKEND=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VLM_MODEL=qwen/qwen2.5-vl-7b-instruct
OPENROUTER_ANSWER_MODEL=openai/gpt-4o-mini
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
VLLM_API_KEY=

# --- Embeddings and rerank ---
# hash is deterministic and needs no download. sentence_transformers uses EMBEDDING_MODEL
# (BAAI/bge-m3 is 1024-d: set EMBEDDING_DIM=1024 and recreate the collection).
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=384
RERANKER_ENABLED=true
# lexical | cross_encoder   (cross_encoder loads BAAI/bge-reranker-v2-m3)
RERANKER_BACKEND=lexical
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=50
USE_TEXT_DENSE=true
USE_VISUAL_DENSE=true
USE_SPARSE=true
FUSION=qdrant
RRF_K=60

# --- Chunking ---
CHUNK_WINDOW_S=45
CHUNK_OVERLAP_S=10
CHUNK_MAX_S=60
KEYFRAME_EVERY_S=30
PHASH_THRESHOLD=6

# --- Limits ---
MAX_VIDEO_SECONDS=14400
MAX_UPLOAD_BYTES=2147483648
MAX_CONCURRENT_JOBS=2
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_S=0.2

# --- Workers ---
# inline (API thread) | poll (python -m pipeline.worker) | celery | ray
WORKER_BACKEND=inline
EAGER_JOBS=false
REDIS_URL=redis://localhost:6379/0

# --- Tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Web (Next.js server side) ---
API_INTERNAL_URL=http://127.0.0.1:43124
