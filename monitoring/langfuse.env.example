# Self-hosted Langfuse is optional. The official compose stack is large
# (Postgres, ClickHouse, Redis, MinIO). For a portfolio demo, a Langfuse Cloud
# project is enough: create a project, then set these on the API and worker.
#
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
#
# Every caption and answer call is also appended to $DATA_DIR/traces.jsonl
# when Langfuse is not configured, so local runs still have a trace log.
